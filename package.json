{
  "name": "reliant-renovations",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "admin:setup": "node --import tsx scripts/create-admin.ts",
    "admin:add": "node --conditions=react-server --import tsx scripts/add-admin.ts",
    "email:preview": "node --import tsx scripts/preview-emails.ts",
    "social:preview": "node --import tsx scripts/generate-social-preview.tsx",
    "social:animate": "node --import tsx scripts/generate-social-animation.tsx",
    "media:migrate": "node --conditions=react-server --import tsx scripts/migrate-media-to-cloudinary.ts",
    "test:integration": "node tests/integration.mjs",
    "format": "prettier --write app components lib scripts tests docs README.md next.config.ts eslint.config.mjs package.json tsconfig.json",
    "db:local": "node scripts/start-local-mongodb.mjs",
    "db:migrate": "node --import tsx scripts/migrate-sqlite-to-mongodb.ts"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.2.8",
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "gsap": "^3.15.0",
    "mongodb": "^7.6.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "three": "^0.185.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.1.6",
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}

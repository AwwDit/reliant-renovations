# Copy to .env.local. Generate both admin values with: npm run admin:setup
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Private recovery address for the single owner account. Required for password reset.
ADMIN_EMAIL=
# Canonical public URL; set to your real production domain before launch.
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Enable indexation only after the real business details and content are verified.
SITE_INDEXABLE=false
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
# Google Maps reviews. Keep the API key server-only and restrict it to Places API (New).
GOOGLE_PLACES_API_KEY=
# Verified Reliant Renovations Inc listing; see docs/GOOGLE-REVIEWS.md.
GOOGLE_PLACES_PLACE_ID=ChIJVynx6aM1DGcR5oq3-3labP8
# MongoDB Atlas or a replica set. Local setup: npm run db:local
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=reliant-local
MONGODB_DB=reliant_renovations
# Cloudinary dynamic folders: public project images and authenticated inquiry attachments.
# Cloudinary is the production default; local is available for development/persistent hosts.
MEDIA_STORAGE=cloudinary
CLOUDINARY_CLOUD_NAME=dbg0zy3al
CLOUDINARY_ASSET_FOLDER=reliant
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Used only for local media storage and the source files during media migration.
DATA_DIR=./data
# Set true only behind a trusted reverse proxy that overwrites X-Forwarded-For.
# When false, all clients share one conservative rate-limit bucket.
TRUST_PROXY=false
# SQLite migration only: DATABASE_PATH=/persistent/reliant.db
# Branded owner alerts, customer confirmations and password recovery through Resend.
# Submissions are always saved in the admin inquiry inbox, even if email fails.
RESEND_API_KEY=
# Private owner notification address; never used as the customer reply-to.
INQUIRY_TO_EMAIL=
# Verified-domain sender, e.g. Reliant Renovations <projects@your-domain.com>
INQUIRY_FROM_EMAIL=
# Customer replies use NEXT_PUBLIC_CONTACT_EMAIL when set, otherwise the sender.
# SITE_URL must be the public production origin for links and the email logo.
